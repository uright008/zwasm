.{
    .name = .zwasm,
    .version = "2.7.0",
    .fingerprint = 0xfdac0191bf453d15,
    // Tracks the machine this fork is developed on: the port (p1/p2/p3b/p3c) is
    // written against that dev build, and dev builds are pruned from
    // ziglang.org, so pinning what we actually run beats naming a version
    // nobody can download. Update it in the same commit that ports to a new one.
    .minimum_zig_version = "0.18.0-dev.357+4812a98ce",
    // No dependencies: the zlinter dev-dep lives in tools/lint/build.zig.zon
    // so that building this package — `static-lib` above all, which C and
    // Rust consumers use — needs no network at all (ADR-0214, #235).
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "LICENSE",
        "legal/THIRD_PARTY.md",
        "README.md",
        "CHANGELOG.md",
    },
}
